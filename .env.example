# Copiez ce fichier vers .env ou utilisez scripts/bootstrap.ps1|sh.
ENVIRONMENT=production
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8787
POSTGRES_DB=micepp
POSTGRES_USER=micepp
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
APP_SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_SECRET
AUDIT_HMAC_KEY=CHANGE_ME_DIFFERENT_RANDOM_64_CHAR_SECRET
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_FULL_NAME=Administrateur MICEPP
ACCESS_TOKEN_MINUTES=60

# Sandbox CAPE/Cuckoo déployée sur le réseau intranet. Laisser vide désactive
# explicitement l'analyse dynamique, sans générer de résultat de simulation.
CAPE_BASE_URL=
CAPE_API_TOKEN=
CAPE_VERIFY_TLS=true
CAPE_POLL_SECONDS=10
CAPE_TIMEOUT_SECONDS=900

# Limites opérationnelles (octets / secondes)
MAX_UPLOAD_BYTES=53687091200
MAX_EXTRACTED_FILES=100000
MAX_EXTRACTED_BYTES=107374182400
YARA_TIMEOUT_SECONDS=30
SANDBOX_RISK_THRESHOLD=55
MODEL_MIN_SAMPLES_PER_CLASS=20
